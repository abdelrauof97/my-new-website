---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% assign entries = "" | split: "" %}
  {% for page in site.pages %}
    {% unless page.sitemap == false or page.url contains "404" or page.url contains "feed" or page.url contains "atom" or page.url contains ".xml" %}
      {% if page.output != false and page.url %}
      <url>
        <loc>{{ site.canonical_host }}{{ page.url }}</loc>
        <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
        <changefreq>{{ page.sitemap_changefreq | default: "monthly" }}</changefreq>
        <priority>{{ page.sitemap_priority | default: "0.6" }}</priority>
      </url>
      {% endif %}
    {% endunless %}
  {% endfor %}
  {% for post in site.posts %}
    {% unless post.published == false or post.sitemap == false %}
    <url>
      <loc>{{ site.canonical_host }}{{ post.url }}</loc>
      <lastmod>{% if post.date %}{{ post.date | date_to_xmlschema }}{% else %}{{ site.time | date_to_xmlschema }}{% endif %}</lastmod>
      <changefreq>yearly</changefreq>
      <priority>0.4</priority>
    </url>
    {% endunless %}
  {% endfor %}
  {% for item in site.portfolio %}
    {% unless item.sitemap == false %}
    <url>
      <loc>{{ site.canonical_host }}{{ item.url }}</loc>
      <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
      <changefreq>yearly</changefreq>
      <priority>0.3</priority>
    </url>
    {% endunless %}
  {% endfor %}
</urlset>
